# Upstream NestJS API base URL (server-only — see lib/env.ts). Docker Compose
# topology dependent: use the sibling stack's host-published port when the two
# subprojects run as separate Compose stacks (current setup), or the Compose
# service name (e.g. http://nestjs-api:3000) if they ever share a network.
API_URL=http://host.docker.internal:3000

# iron-session encryption password — must be at least 32 characters. Generate
# a fresh one for production; never reuse this dev value.
SESSION_PASSWORD=dev-only-session-password-change-in-prod-32chars
