{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest",
    "^.+\\.mjs$": "<rootDir>/../jest-esm-transform.js"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@tus|srvx)/)"
  ],
  "setupFiles": ["dotenv/config"]
}
